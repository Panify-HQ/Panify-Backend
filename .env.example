# Nombre que identifica la API en logs y documentación.
APP_NAME=Panify API

# Entorno de ejecución (por ejemplo: development, testing o production).
APP_ENV=development

# Activa opciones de depuración. Mantén false en producción.
DEBUG=true

# Prefijo común de las rutas de la API versionada.
API_V1_PREFIX=/api/v1

# URL de conexión a MySQL: dialecto+driver://usuario:contraseña@host:puerto/base_de_datos.
# Codifica caracteres especiales de la contraseña para que sean válidos en una URL.
DATABASE_URL=mysql+pymysql://usuario:contrasena@localhost:3306/panify

# Clave privada usada para firmar y validar tokens JWT.
# Genera una clave propia y segura; no uses este texto de ejemplo en producción.
# Puedes generar una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SECRETA

# Algoritmo con el que se firman los JWT. Debe coincidir al crear y validar tokens.
JWT_ALGORITHM=HS256

# Duración del token de acceso, expresada en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Orígenes web autorizados para hacer peticiones al backend (configuración CORS).
# Mantén el formato de lista JSON y reemplaza los puertos por los de tu frontend.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Configuración SMTP usada para enviar códigos de recuperación de contraseña.
# Para Gmail, usa una contraseña de aplicación, no la contraseña normal de la cuenta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo-emisor@gmail.com
SMTP_PASSWORD=CONTRASENA_DE_APLICACION

# Nombre visible del remitente en los correos enviados por la aplicación.
SMTP_FROM_NAME=Panify

# URL base de la API que consume el frontend Vite.
# Esta variable la lee el frontend; el backend la ignora.
VITE_API_URL=http://localhost:8000/api/v1
